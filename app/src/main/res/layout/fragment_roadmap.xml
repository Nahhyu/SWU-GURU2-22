<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingTop="50dp"
        android:paddingEnd="20dp"
        android:paddingBottom="30dp">

        <TextView
            style="@style/TextAppearance.HobbyMate.Headline"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/roadmap_title" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="@string/roadmap_description"
            android:textColor="@color/on_surface_variant"
            android:textSize="14sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="112dp"
            android:layout_marginTop="18dp"
            android:background="@drawable/bg_dark_card"
            android:gravity="center_vertical"
            android:orientation="vertical"
            android:paddingHorizontal="20dp">

            <TextView
                android:id="@+id/textRoadmapGoal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:maxLines="2"
                android:textColor="@color/white"
                android:textSize="18sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/textRoadmapTags"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:textColor="#E4DFDC"
                android:textSize="12sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/textRoadmapProgress"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:textColor="@color/on_background"
            android:textSize="14sp"
            android:textStyle="bold" />

        <com.google.android.material.progressindicator.LinearProgressIndicator
            android:id="@+id/roadmapProgress"
            android:layout_width="match_parent"
            android:layout_height="6dp"
            android:layout_marginTop="10dp"
            android:max="100"
            android:progress="0"
            app:indicatorColor="@color/primary"
            app:trackColor="@color/disabled"
            app:trackCornerRadius="4dp" />

        <LinearLayout
            android:id="@+id/weekContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:orientation="vertical" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/buttonOpenWeek"
            style="@style/Widget.HobbyMate.PrimaryButton"
            android:layout_width="match_parent"
            android:layout_height="58dp"
            android:layout_marginTop="18dp" />
    </LinearLayout>
</ScrollView>
