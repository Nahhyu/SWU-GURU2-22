<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingTop="50dp"
        android:paddingEnd="20dp"
        android:paddingBottom="28dp">

        <TextView
            style="@style/TextAppearance.HobbyMate.Headline"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/daily_guide_title" />

        <TextView
            android:id="@+id/textDailyActivityTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/daily_activity_title"
            android:textColor="@color/on_surface_variant"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/textEstimatedDuration"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp"
            android:text="@string/estimated_duration_pending"
            android:textColor="@color/on_surface_variant"
            android:textSize="14sp" />

        <FrameLayout
            android:id="@+id/videoPreview"
            android:layout_width="match_parent"
            android:layout_height="220dp"
            android:layout_marginTop="22dp"
            android:background="@drawable/bg_video">

            <WebView
                android:id="@+id/youtubePlayer"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@color/video_background"
                android:contentDescription="@string/youtube_player" />

            <ProgressBar
                android:id="@+id/progressVideoPlayer"
                android:layout_width="42dp"
                android:layout_height="42dp"
                android:layout_gravity="center"
                android:indeterminateTint="@color/primary" />

            <TextView
                android:id="@+id/textVideoUnavailable"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:gravity="center"
                android:padding="20dp"
                android:text="@string/video_embed_unavailable"
                android:textColor="@color/white"
                android:textSize="14sp"
                android:visibility="gone" />
        </FrameLayout>

        <TextView
            android:id="@+id/textSelectedVideoTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:ellipsize="end"
            android:maxLines="2"
            android:textColor="@color/on_background"
            android:textSize="14sp"
            android:textStyle="bold"
            android:visibility="gone" />

        <TextView
            style="@style/TextAppearance.HobbyMate.Section"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="22dp"
            android:text="@string/step_checklist" />

        <LinearLayout
            android:id="@+id/analysisLoadingContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:gravity="center"
            android:orientation="vertical"
            android:paddingVertical="24dp">

            <ProgressBar
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:indeterminateTint="@color/primary" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="@string/analyzing_video"
                android:textColor="@color/on_surface_variant"
                android:textSize="13sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/analysisErrorContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:gravity="center"
            android:orientation="vertical"
            android:paddingVertical="16dp"
            android:visibility="gone">

            <TextView
                android:id="@+id/textAnalysisError"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:textColor="@color/on_surface_variant"
                android:textSize="13sp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/buttonRetryAnalysis"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="48dp"
                android:layout_marginTop="4dp"
                android:text="@string/retry"
                android:textColor="@color/primary" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/checklistContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone" />

        <TextView
            android:id="@+id/textGuideProgress"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="@string/guide_progress_pending"
            android:textColor="@color/on_background"
            android:textSize="15sp"
            android:textStyle="bold" />

        <com.google.android.material.progressindicator.LinearProgressIndicator
            android:id="@+id/guideProgress"
            android:layout_width="match_parent"
            android:layout_height="6dp"
            android:layout_marginTop="9dp"
            android:progress="0"
            app:indicatorColor="@color/primary"
            app:trackColor="@color/disabled"
            app:trackCornerRadius="4dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/buttonCompleteSession"
            style="@style/Widget.HobbyMate.PrimaryButton"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:layout_marginTop="12dp"
            android:enabled="false"
            android:text="@string/complete_session" />
    </LinearLayout>
</ScrollView>
