<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="92dp"
    android:layout_marginBottom="11dp"
    app:cardBackgroundColor="@color/surface"
    app:cardCornerRadius="18dp"
    app:cardElevation="0dp"
    app:strokeColor="@color/outline"
    app:strokeWidth="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="16dp">

        <TextView
            android:id="@+id/hobbyIcon"
            android:layout_width="52dp"
            android:layout_height="52dp"
            android:background="@drawable/bg_hobby_icon_running"
            android:gravity="center"
            android:textSize="25sp" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="15dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/hobbyName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="@color/on_background"
                android:textSize="17sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/hobbyCategory"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:textColor="@color/on_surface_variant"
                android:textSize="13sp" />

            <ProgressBar
                android:id="@+id/hobbyProgress"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent"
                android:layout_height="5dp"
                android:layout_marginTop="8dp"
                android:max="100"
                android:progressBackgroundTint="@color/disabled"
                android:progressTint="@color/primary" />
        </LinearLayout>

        <TextView
            android:id="@+id/hobbyMatch"
            android:layout_width="70dp"
            android:layout_height="wrap_content"
            android:gravity="end"
            android:textColor="@color/primary"
            android:textSize="14sp"
            android:textStyle="bold" />

        <RadioButton
            android:id="@+id/hobbyRadio"
            android:layout_width="42dp"
            android:layout_height="42dp"
            android:buttonTint="@color/primary"
            android:clickable="false"
            android:focusable="false" />
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
