<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background"
    android:orientation="vertical">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="19dp"
            android:paddingTop="50dp"
            android:paddingEnd="19dp"
            android:paddingBottom="24dp">

            <TextView
                style="@style/TextAppearance.HobbyMate.Headline"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/hobby_recommend_title" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/recommend_description"
                android:textColor="@color/on_surface_variant"
                android:textSize="14sp" />

            <LinearLayout
                android:id="@+id/recommendationContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:orientation="vertical" />

            <TextView
                android:id="@+id/buttonBrowseAll"
                android:layout_width="wrap_content"
                android:layout_height="52dp"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="13dp"
                android:gravity="center"
                android:text="@string/browse_all_hobbies"
                android:textColor="@color/on_surface_variant"
                android:textSize="14sp"
                android:textStyle="bold" />
        </LinearLayout>
    </ScrollView>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="104dp"
        android:background="@color/surface"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="27dp">

        <TextView
            android:id="@+id/textSelectedCount"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/selected_count"
            android:textColor="@color/on_surface_variant"
            android:textSize="14sp"
            android:textStyle="bold" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/buttonRecommendationDetail"
            style="@style/Widget.HobbyMate.PrimaryButton"
            android:layout_width="122dp"
            android:layout_height="54dp"
            android:text="@string/select_hobby" />
    </LinearLayout>
</LinearLayout>
