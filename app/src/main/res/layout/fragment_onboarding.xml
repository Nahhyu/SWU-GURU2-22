<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="760dp"
        android:orientation="vertical"
        android:paddingStart="19dp"
        android:paddingTop="54dp"
        android:paddingEnd="19dp"
        android:paddingBottom="28dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <LinearLayout
                android:id="@+id/progressSegments"
                android:layout_width="wrap_content"
                android:layout_height="10dp"
                android:orientation="horizontal">

                <View
                    android:id="@+id/progressOne"
                    android:layout_width="25dp"
                    android:layout_height="10dp"
                    android:background="@drawable/bg_progress_track" />

                <View
                    android:id="@+id/progressTwo"
                    android:layout_width="10dp"
                    android:layout_height="10dp"
                    android:layout_marginStart="6dp"
                    android:background="@drawable/bg_progress_track" />

                <View
                    android:id="@+id/progressThree"
                    android:layout_width="10dp"
                    android:layout_height="10dp"
                    android:layout_marginStart="6dp"
                    android:background="@drawable/bg_progress_track" />

                <View
                    android:id="@+id/progressFour"
                    android:layout_width="10dp"
                    android:layout_height="10dp"
                    android:layout_marginStart="6dp"
                    android:background="@drawable/bg_progress_track" />

                <View
                    android:id="@+id/progressFive"
                    android:layout_width="10dp"
                    android:layout_height="10dp"
                    android:layout_marginStart="6dp"
                    android:background="@drawable/bg_progress_track" />
            </LinearLayout>

            <Space
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <TextView
                android:id="@+id/textStep"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/step_format"
                android:textColor="@color/on_surface_variant"
                android:textSize="16sp"
                android:textStyle="bold" />
        </LinearLayout>

        <TextView
            android:id="@+id/textQuestion"
            style="@style/TextAppearance.HobbyMate.Headline"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="34dp"
            android:text="@string/question_one" />

        <LinearLayout
            android:id="@+id/optionsContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:orientation="vertical" />

        <TextView
            android:id="@+id/buttonSkip"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="20dp"
            android:gravity="center"
            android:paddingHorizontal="8dp"
            android:text="@string/skip"
            android:textColor="@color/on_surface_variant"
            android:textSize="15sp" />
    </LinearLayout>
</ScrollView>
