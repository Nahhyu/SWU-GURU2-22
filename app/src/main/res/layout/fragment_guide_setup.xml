<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background"
    android:focusable="true"
    android:focusableInTouchMode="true">

    <ScrollView
        android:id="@+id/formContainer"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="17dp"
            android:paddingTop="54dp"
            android:paddingEnd="17dp"
            android:paddingBottom="28dp">

            <TextView
                style="@style/TextAppearance.HobbyMate.Section"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/current_level" />

            <com.google.android.material.button.MaterialButtonToggleGroup
                android:id="@+id/levelToggle"
                android:layout_width="match_parent"
                android:layout_height="58dp"
                android:layout_marginTop="12dp"
                app:checkedButton="@id/buttonLevelFirst"
                app:selectionRequired="true"
                app:singleSelection="true">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/buttonLevelFirst"
                    style="@style/Widget.HobbyMate.ChoiceButton"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:text="@string/level_first" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/buttonLevelSome"
                    style="@style/Widget.HobbyMate.ChoiceButton"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_marginStart="7dp"
                    android:layout_weight="1"
                    android:text="@string/level_some" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/buttonLevelRegular"
                    style="@style/Widget.HobbyMate.ChoiceButton"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_marginStart="7dp"
                    android:layout_weight="1"
                    android:text="@string/level_regular" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/buttonLevelExpert"
                    style="@style/Widget.HobbyMate.ChoiceButton"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_marginStart="7dp"
                    android:layout_weight="1"
                    android:text="@string/level_expert" />
            </com.google.android.material.button.MaterialButtonToggleGroup>

            <TextView
                style="@style/TextAppearance.HobbyMate.Section"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="27dp"
                android:text="@string/goal" />

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/goalInputLayout"
                style="@style/Widget.HobbyMate.Input"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="11dp"
                android:hint="@string/goal_hint">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/editGoal"
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:imeOptions="actionNext"
                    android:inputType="textCapSentences"
                    android:maxLength="80"
                    android:paddingHorizontal="17dp"
                    android:text="@string/sample_goal"
                    android:textColor="@color/on_background"
                    android:textSize="16sp"
                    android:textStyle="bold" />
            </com.google.android.material.textfield.TextInputLayout>

            <TextView
                style="@style/TextAppearance.HobbyMate.Section"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="27dp"
                android:text="@string/duration_weeks" />

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/durationInputLayout"
                style="@style/Widget.HobbyMate.Input"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="11dp"
                android:hint="@string/duration_hint"
                app:suffixText="@string/week_suffix">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/editDurationWeeks"
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:digits="0123456789"
                    android:imeOptions="actionDone"
                    android:inputType="number"
                    android:maxLength="2"
                    android:paddingHorizontal="17dp"
                    android:text="12"
                    android:textColor="@color/on_background"
                    android:textSize="16sp"
                    android:textStyle="bold" />
            </com.google.android.material.textfield.TextInputLayout>

            <TextView
                style="@style/TextAppearance.HobbyMate.Section"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="28dp"
                android:text="@string/minutes_per_session" />

            <com.google.android.material.button.MaterialButtonToggleGroup
                android:id="@+id/timeToggle"
                android:layout_width="match_parent"
                android:layout_height="57dp"
                android:layout_marginTop="11dp"
                app:checkedButton="@id/buttonTime30"
                app:selectionRequired="true"
                app:singleSelection="true">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/buttonTime15"
                    style="@style/Widget.HobbyMate.ChoiceButton"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:text="@string/time_15" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/buttonTime30"
                    style="@style/Widget.HobbyMate.ChoiceButton"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_marginStart="8dp"
                    android:layout_weight="1"
                    android:text="@string/time_30" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/buttonTime60"
                    style="@style/Widget.HobbyMate.ChoiceButton"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_marginStart="8dp"
                    android:layout_weight="1"
                    android:text="@string/time_60" />
            </com.google.android.material.button.MaterialButtonToggleGroup>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="11dp"
                android:text="@string/frequency"
                android:textColor="@color/on_surface_variant"
                android:textSize="15sp"
                android:textStyle="bold" />

            <com.google.android.material.button.MaterialButtonToggleGroup
                android:id="@+id/frequencyToggle"
                android:layout_width="match_parent"
                android:layout_height="57dp"
                android:layout_marginTop="6dp"
                app:checkedButton="@id/buttonFrequencyFive"
                app:selectionRequired="true"
                app:singleSelection="true">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/buttonFrequencyThree"
                    style="@style/Widget.HobbyMate.ChoiceButton"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:text="@string/frequency_three" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/buttonFrequencyFive"
                    style="@style/Widget.HobbyMate.ChoiceButton"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_marginStart="8dp"
                    android:layout_weight="1"
                    android:text="@string/frequency_five" />
            </com.google.android.material.button.MaterialButtonToggleGroup>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/buttonGenerateGuide"
                style="@style/Widget.HobbyMate.PrimaryButton"
                android:layout_width="match_parent"
                android:layout_height="60dp"
                android:layout_marginTop="38dp"
                android:text="@string/generate_guide" />
        </LinearLayout>
    </ScrollView>

    <LinearLayout
        android:id="@+id/loadingContainer"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/background"
        android:gravity="center"
        android:orientation="vertical"
        android:visibility="gone">

        <com.google.android.material.progressindicator.CircularProgressIndicator
            android:layout_width="92dp"
            android:layout_height="92dp"
            android:indeterminate="true"
            app:indicatorColor="@color/primary"
            app:indicatorSize="88dp"
            app:trackColor="@color/background"
            app:trackThickness="8dp" />

        <TextView
            android:id="@+id/textLoadingSubtitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:text="로드맵 생성 중"
            android:textColor="@color/on_background"
            android:textSize="21sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="맞춤 12주 커리큘럼을 만들고 있어요"
            android:textColor="@color/on_surface_variant"
            android:textSize="15sp" />
    </LinearLayout>
</FrameLayout>
