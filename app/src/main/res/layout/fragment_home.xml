<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="19dp"
        android:paddingTop="58dp"
        android:paddingEnd="19dp"
        android:paddingBottom="34dp">

        <TextView
            style="@style/TextAppearance.HobbyMate.Headline"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/home_greeting"
            android:textSize="20sp" />

        <LinearLayout
            android:id="@+id/activeGuideCard"
            android:layout_width="match_parent"
            android:layout_height="100dp"
            android:layout_marginTop="18dp"
            android:background="@drawable/bg_dark_card"
            android:clickable="true"
            android:focusable="true"
            android:orientation="vertical"
            android:paddingHorizontal="23dp"
            android:paddingTop="15dp"
            android:visibility="gone">

            <TextView
                android:id="@+id/textHomeActiveHobby"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="#E4DFDC"
                android:textSize="12sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/textHomeTodayGoal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:maxLines="1"
                android:textColor="@color/white"
                android:textSize="16sp"
                android:textStyle="bold" />

            <com.google.android.material.progressindicator.LinearProgressIndicator
                android:id="@+id/homeGuideProgress"
                android:layout_width="match_parent"
                android:layout_height="7dp"
                android:layout_marginTop="14dp"
                android:max="100"
                android:progress="0"
                app:indicatorColor="@color/primary"
                app:trackColor="#6D6865" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/emptyGuideCard"
            android:layout_width="match_parent"
            android:layout_height="100dp"
            android:layout_marginTop="18dp"
            android:background="@drawable/bg_dark_card"
            android:gravity="center_vertical"
            android:orientation="vertical"
            android:paddingHorizontal="23dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/home_no_guide_title"
                android:textColor="@color/white"
                android:textSize="18sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="7dp"
                android:text="@string/home_no_guide_description"
                android:textColor="#E4DFDC"
                android:textSize="13sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/textSelectedHobbiesHeader"
            style="@style/TextAppearance.HobbyMate.Section"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:textSize="16sp" />

        <GridLayout
            android:id="@+id/selectedHobbyContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:alignmentMode="alignMargins"
            android:columnCount="2"
            android:useDefaultMargins="false" />

        <TextView
            android:id="@+id/textPendingHobbiesHeader"
            style="@style/TextAppearance.HobbyMate.Section"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="11dp"
            android:text="@string/another_recommendation"
            android:textSize="16sp" />

        <GridLayout
            android:id="@+id/homeRecommendationContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:alignmentMode="alignMargins"
            android:columnCount="2"
            android:useDefaultMargins="false" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/buttonFindNewHobby"
            style="@style/Widget.HobbyMate.PrimaryButton"
            android:layout_width="match_parent"
            android:layout_height="58dp"
            android:layout_marginTop="24dp"
            android:text="@string/find_new_hobby" />
    </LinearLayout>
</ScrollView>
